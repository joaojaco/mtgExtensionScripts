{
  "manifest_version": 3,
  "name": "Magic Extension - EDHREC & Archidekt Tools",
  "version": "2.1",
  "description": "Ferramentas para Magic: The Gathering",
  "permissions": [
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "https://api.scryfall.com/*"
  ],
  "background": {
    "service_worker": "rightClickButton-options.js"
  },
  "content_scripts": [
    {
      "matches": ["https://edhrec.com/*"],
      "js": ["alt-HoverImage.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Abrir Ferramentas MTG"
  },
  "omnibox": {
    "keyword": "sc"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "setSelector.html",
        "manaCalculator.html",
        "manaCalculator.js",
        "resultadoSet.html",
        "resultadoSet.js"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}