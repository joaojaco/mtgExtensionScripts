{
  "manifest_version": 3,
  "name": "Magic Extension - EDHREC & Archidekt Tools",
  "version": "1.8",
  "description": "Ferramentas para Magic: The Gathering (Seletor de Sets e Calculadora de Mana)",
  "permissions": [
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "https://api.scryfall.com/*"
  ],
  "background": {
    "service_worker": "rightClickButton-options.js"
  },
  "content_scripts": [
    {
      "matches": ["https://edhrec.com/*"],
      "js": ["alt-HoverImage.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Abrir Ferramentas MTG"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "setSelector.html",
        "manaCalculator.html",
        "manaCalculator.js"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}